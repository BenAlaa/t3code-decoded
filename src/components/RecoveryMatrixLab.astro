---
import {
  getSourceReference,
  sourceReferenceHref,
  sourceReferenceLabel,
} from "../lib/sources";

interface Props {
  id?: string;
}

const { id = "cross-store-recovery" } = Astro.props;
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id)) {
  throw new Error("RecoveryMatrixLab requires a stable kebab-case id.");
}

const rows = [
  {
    label: "Service update",
    pair: "SQLite + WAL + SHM",
    order: "Persist pending update → stop old child → stage and sync triplet backup → run trial; marker is written only before rollback restore",
    residue: "Pending service state identifies the unfinished trial. A restore marker inside the backup identifies an interrupted rollback restore.",
    startup: "Conditional. Pending state resumes the trial when no restore marker exists; a restore marker makes startup retry the rollback restoration first.",
    boundary: "Strongest recovery path, but it covers the SQLite triplet only—not attachments, settings, logs, or Git refs.",
    verdict: "Journaled",
    tone: "safe",
    sourceIds: ["service-update-recovery"],
  },
  {
    label: "Settings update",
    pair: "settings.json + secret files",
    order: "Write/remove secrets → normalize redacted settings → rename settings JSON → update cache",
    residue: "A failed JSON write can leave a new orphan secret or a redacted pointer whose old secret was removed.",
    startup: "No pair reconciler. Missing or malformed settings fall back to defaults; missing secret materializes as empty.",
    boundary: "Each file operation has local safeguards, but the group is not one transaction.",
    verdict: "Saga gap",
    tone: "warning",
    sourceIds: ["settings-load-fallbacks", "settings-secret-order", "settings-atomic-write", "secret-store-atomic-boundary"],
  },
  {
    label: "Attachments",
    pair: "image files + SQL references",
    order: "Normalize and write file before dispatch; projector commits cursor before post-transaction cleanup",
    residue: "Rejected/retried commands can orphan files; failed cleanup after cursor advance is not retried from that event; a delete can precede a later outer rollback.",
    startup: "The pinned production-code audit found no repository-wide orphan collector. Cursor advancement can prevent the same cleanup from replaying.",
    boundary: "Path validation is strong; lifecycle atomicity across filesystem and SQLite is not.",
    verdict: "Unreconciled",
    tone: "failure",
    sourceIds: ["attachment-path-safety", "normalizer-staging-boundary", "attachment-projection-cleanup", "engine-commit-publication"],
  },
  {
    label: "Terminal history",
    pair: "memory/PTY + history file",
    order: "Update memory → coalesce for 40 ms → overwrite history; explicit close persists and drains",
    residue: "A hard crash can lose the coalescing window. Direct overwrite creates partial-write risk; saved text cannot reconstruct PTY process state.",
    startup: "The saved text is loaded on first open, then a new PTY starts. General scope cleanup does not prove a history drain.",
    boundary: "Useful continuity of text, not a transactional terminal replay.",
    verdict: "Best effort",
    tone: "warning",
    sourceIds: ["terminal-history-defaults", "terminal-history-persistence", "terminal-output-persistence-order", "terminal-explicit-close", "terminal-scope-finalizer", "terminal-lazy-history-open"],
  },
  {
    label: "Checkpoint",
    pair: "hidden Git ref + SQL checkpoint metadata",
    order: "Build isolated-index tree → update hidden ref → dispatch checkpoint metadata",
    residue: "A crash can orphan the ref. Revert mutates workspace, provider state, and newer refs before recording completion.",
    startup: "The pinned production-code audit found no ref/SQL reconciler. Capture also collapses staged and unstaged content; restore resets the index toward HEAD.",
    boundary: "File content is recoverable on a successful restore, but staging boundaries and cross-store saga progress are not.",
    verdict: "Unjournaled",
    tone: "failure",
    sourceIds: ["checkpoint-git-capture-restore", "checkpoint-capture-dispatch-order", "checkpoint-revert-saga"],
  },
];

const resolved = rows.map(({ sourceIds, ...row }) => ({
  ...row,
  sources: sourceIds.map((sourceId) => {
    const source = getSourceReference(sourceId);
    return { label: sourceReferenceLabel(source), href: sourceReferenceHref(source) };
  }),
}));
const payload = JSON.stringify(resolved).replaceAll("<", "\\u003c");
const first = resolved[0];
---

<section class="recovery-lab" data-recovery-matrix aria-labelledby={`${id}-title`}>
  <header>
    <span>Recovery matrix</span>
    <h3 id={`${id}-title`}>Select a persistence boundary</h3>
    <p>The table stays complete; selection expands one crash story without hiding the comparison.</p>
  </header>

  <div class="matrix-scroll" tabindex="0" role="region" aria-label="Cross-store crash and recovery matrix">
    <table>
      <thead>
        <tr><th scope="col">Boundary</th><th scope="col">Write order</th><th scope="col">Crash residue</th><th scope="col">Startup repair</th></tr>
      </thead>
      <tbody>
        {resolved.map((row, index) => (
          <tr data-recovery-row={index} class:list={[`tone-${row.tone}`, { selected: index === 0 }]}>
            <th scope="row">
              <button type="button" data-recovery-select={index} aria-pressed={index === 0 ? "true" : "false"}>
                <strong>{row.label}</strong><span>{row.pair}</span><em>{row.verdict}</em>
              </button>
            </th>
            <td>{row.order}</td>
            <td>{row.residue}</td>
            <td>{row.startup}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-recovery-status>
    Selected {first.label}: {first.verdict}
  </p>
  <article class:list={["matrix-detail", `tone-${first.tone}`]} data-recovery-detail>
    <div><span data-recovery-verdict>{first.verdict}</span><h4 data-recovery-title>{first.label} · {first.pair}</h4></div>
    <p data-recovery-boundary>{first.boundary}</p>
    <nav aria-label="Sources for selected recovery boundary" data-recovery-sources>
      {first.sources.map((source) => <a href={source.href} rel="noreferrer"><code>{source.label}</code> ↗</a>)}
    </nav>
  </article>
  <noscript><p class="noscript-note">The complete matrix above remains available without JavaScript.</p></noscript>
  <script type="application/json" data-recovery-data set:html={payload}></script>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-recovery-matrix]").forEach((lab) => {
    if (lab.dataset.recoveryReady === "true") return;
    lab.dataset.recoveryReady = "true";
    const rows = JSON.parse(lab.querySelector("[data-recovery-data]")?.textContent ?? "[]");
    const selectors = [...lab.querySelectorAll<HTMLButtonElement>("[data-recovery-select]")];
    const tableRows = [...lab.querySelectorAll<HTMLElement>("[data-recovery-row]")];
    const detail = lab.querySelector<HTMLElement>("[data-recovery-detail]");
    let index = 0;

    const setText = (selector: string, value: string) => {
      const target = lab.querySelector(selector);
      if (target) target.textContent = value;
    };
    const renderSources = (sources: Array<{ label: string; href: string }>) => {
      const nav = lab.querySelector("[data-recovery-sources]");
      if (!nav) return;
      nav.replaceChildren(...sources.map((source) => {
        const link = document.createElement("a");
        link.href = source.href;
        link.rel = "noreferrer";
        const code = document.createElement("code");
        code.textContent = source.label;
        link.append(code, " ↗");
        return link;
      }));
    };
    const paint = (requested: number, focus = false) => {
      const row = rows[requested];
      if (!row) return;
      index = requested;
      selectors.forEach((selector, selectorIndex) => selector.setAttribute("aria-pressed", String(selectorIndex === index)));
      tableRows.forEach((tableRow, rowIndex) => tableRow.classList.toggle("selected", rowIndex === index));
      if (detail) detail.className = `matrix-detail tone-${row.tone}`;
      setText("[data-recovery-verdict]", row.verdict);
      setText("[data-recovery-title]", `${row.label} · ${row.pair}`);
      setText("[data-recovery-boundary]", row.boundary);
      setText("[data-recovery-status]", `Selected ${row.label}: ${row.verdict}`);
      renderSources(row.sources);
      if (focus) selectors[index]?.focus();
    };
    selectors.forEach((selector) => {
      selector.addEventListener("click", () => paint(Number(selector.dataset.recoverySelect)));
      selector.addEventListener("keydown", (event) => {
        const focusedIndex = Number(selector.dataset.recoverySelect);
        let requested: number | undefined;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") requested = (focusedIndex + 1) % selectors.length;
        if (event.key === "ArrowUp" || event.key === "ArrowLeft") requested = (focusedIndex - 1 + selectors.length) % selectors.length;
        if (event.key === "Home") requested = 0;
        if (event.key === "End") requested = selectors.length - 1;
        if (requested === undefined) return;
        event.preventDefault();
        paint(requested, true);
      });
    });
  });
</script>

<style>
  .recovery-lab {
    margin: 2.4rem 0;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper-raised);
    box-shadow: var(--shadow);
    font-family: var(--font-ui);
  }
  header { padding: 1.15rem 1.25rem .9rem; border-bottom: 1px solid var(--line); }
  header > span { color: var(--signal-deep); font: 750 .66rem/1 var(--font-ui); letter-spacing: .13em; text-transform: uppercase; }
  h3 { margin: .38rem 0 .2rem; font: 750 1.24rem/1.2 var(--font-display); letter-spacing: -.02em; }
  header p { margin: 0; color: var(--ink-soft); font: .82rem/1.5 var(--font-ui); }
  .matrix-scroll { overflow: auto; scrollbar-width: thin; }
  table { width: 100%; min-width: 850px; border-collapse: collapse; table-layout: fixed; font: .69rem/1.42 var(--font-ui); }
  th, td { padding: .72rem; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  thead th { position: sticky; top: 0; z-index: 1; background: var(--paper-muted); color: var(--ink-faint); font: 750 .6rem/1.2 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; }
  thead th:first-child { width: 22%; }
  tbody th { padding: 0; border-left: 4px solid transparent; }
  tbody tr.selected th { border-left-color: var(--signal); }
  tbody tr.selected { background: color-mix(in srgb, var(--signal-soft) 48%, transparent); }
  tbody button {
    width: 100%; min-height: 100%; display: grid; gap: .24rem; padding: .72rem;
    border: 0; background: transparent; color: var(--ink); cursor: pointer; text-align: left;
  }
  tbody button strong { font: 750 .76rem/1.2 var(--font-ui); }
  tbody button span { color: var(--ink-soft); font: .65rem/1.35 var(--font-ui); }
  tbody button em { justify-self: start; color: var(--signal-deep); font: 750 .58rem/1 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; }
  .matrix-detail { margin: 1rem 1.25rem 1.25rem; padding: .9rem 1rem; border-left: 4px solid var(--line-strong); background: var(--paper-muted); }
  .matrix-detail.tone-safe { border-left-color: var(--green); }
  .matrix-detail.tone-warning { border-left-color: var(--orange); }
  .matrix-detail.tone-failure { border-left-color: var(--signal); }
  .matrix-detail > div { display: flex; align-items: baseline; gap: .55rem; }
  .matrix-detail span { color: var(--signal-deep); font: 750 .59rem/1 var(--font-ui); letter-spacing: .1em; text-transform: uppercase; }
  h4 { margin: 0; font: 750 .98rem/1.3 var(--font-display); }
  .matrix-detail p { margin: .4rem 0 .65rem; color: var(--ink-soft); font: .75rem/1.5 var(--font-ui); }
  .matrix-detail nav { display: flex; flex-wrap: wrap; gap: .45rem .8rem; }
  .matrix-detail a { color: var(--blue); font: 600 .64rem/1.35 var(--font-ui); }
  .noscript-note { margin: 0 1.25rem 1rem; color: var(--ink-faint); font: .7rem/1.4 var(--font-ui); }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
  }
  @media print {
    .recovery-lab { box-shadow: none; break-inside: avoid-page; }
    .matrix-scroll { overflow: visible; }
    table { min-width: 0; table-layout: auto; font-size: 7.5pt; }
    thead th { position: static; }
    .matrix-detail, .noscript-note { display: none; }
    tbody tr.selected { background: transparent; }
    tbody button { padding: 0; }
  }
</style>
