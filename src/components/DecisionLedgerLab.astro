---
interface Props {
  id?: string;
}

const { id = "architecture-decision-ledger" } = Astro.props;
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id)) {
  throw new Error("DecisionLedgerLab requires a stable kebab-case id.");
}

const decisions = [
  {
    category: "domain",
    classification: "Shipped",
    title: "Server authority",
    pressure: "Remote clients must control one workspace without becoming competing owners of provider processes, Git, terminals, or files.",
    choice: "One environment server owns product authority; clients use authenticated RPC and projections.",
    benefit: "Authorization, orchestration, workspace effects, and durable product history meet at one address.",
    cost: "Availability and recovery depend on that environment; clients reconcile rather than write authoritatively.",
    alternative: "Client-owned or peer-to-peer workspaces with a separate conflict and credential model.",
    trigger: "Concurrent offline editing or multi-writer workspace authority becomes a core requirement.",
  },
  {
    category: "domain",
    classification: "Shipped",
    title: "Transactional event core",
    pressure: "A command needs a durable acceptance boundary and a retry answer before external work completes.",
    choice: "Decide, append events, fold projections, and write a receipt in one SQLite transaction.",
    benefit: "Accepted intent and its receipt survive together; failed transactions leave no acceptance result.",
    cost: "Files, provider calls, and later delivery remain outside the transaction; projections require maintenance.",
    alternative: "Direct CRUD where replayable history and independently shaped read models are not valuable.",
    trigger: "Immutable command history and projection diversity stop paying for their operational complexity.",
  },
  {
    category: "delivery",
    classification: "Shipped",
    title: "Hot post-commit reactors",
    pressure: "Do not call a harness while the domain transaction could still roll back.",
    choice: "Publish committed events to scoped, hot reactor workers; keep failures isolated from acceptance.",
    benefit: "Rollback cannot have caused provider work, and one consumer failure does not undo durable history.",
    cost: "A crash after commit can lose pending observation; sends and runtime ingestion are not a durable outbox.",
    alternative: "Durable outbox with attempts, idempotency keys, and a policy for ambiguous external acceptance.",
    trigger: "An accepted turn must eventually imply an attempted provider send across process loss.",
  },
  {
    category: "delivery",
    classification: "Shipped",
    title: "Snapshot + cursor",
    pressure: "Clients need rebuildable read state and bounded resume without calling every page one global snapshot.",
    choice: "Each projection advances its own cursor; composed snapshots use a safe watermark and subscriptions repair gaps.",
    benefit: "Read models evolve independently and can rebuild from committed events.",
    cost: "Several watermarks, order-sensitive projectors, replay limits, and client race guards must remain intelligible.",
    alternative: "One authoritative document per thread with fewer projections and less independent fan-out.",
    trigger: "Projection lag, cross-view joins, or replay operations exceed the current cursor model's operating envelope.",
  },
  {
    category: "integration",
    classification: "Shipped",
    title: "Provider adapters",
    pressure: "Harnesses disagree about sessions, approvals, streams, context, and process ownership.",
    choice: "A narrow adapter contract emits canonical runtime facts while ProviderService owns product policy and routing.",
    benefit: "One product model preserves native provenance without inventing false provider parity.",
    cost: "Adapter maintenance and capability differences remain explicit; no universal conformance proof exists.",
    alternative: "A stricter generic protocol that may discard native features or push product policy into every driver.",
    trigger: "Important native lifecycles require pervasive escape hatches that the canonical contract cannot express.",
  },
  {
    category: "connectivity",
    classification: "Shipped",
    title: "One reconnect owner",
    pressure: "Several views and devices can observe an environment without independent retry loops or merged authorities.",
    choice: "An environment-scoped supervisor owns generations and one active lease; caches synchronize separately.",
    benefit: "Transport lifecycle has one owner while shell and thread views keep precise refresh boundaries.",
    cost: "Leases, generations, and surface-specific reconciliation add client-runtime complexity.",
    alternative: "A global connection manager that would need another way to preserve environment ownership.",
    trigger: "The product adds a real cross-environment write model, not just combined presentation.",
  },
  {
    category: "connectivity",
    classification: "Shipped",
    title: "Durable mobile intent outbox",
    pressure: "A user can send while the phone loses connectivity or foreground time.",
    choice: "Optimistically enqueue, persist durably, then confirm and deliver through a serialized mobile outbox.",
    benefit: "User intent can survive locally before the environment can accept it.",
    cost: "Backoff, existence guards, confirmation, and delivery choices become a separate lifecycle.",
    alternative: "Always-online direct send, sacrificing the local recovery contract.",
    trigger: "Intent becomes multi-device collaborative work needing server-issued identities or all clients need the same queue.",
  },
  {
    category: "operations",
    classification: "Shipped",
    title: "Exact-version updates",
    pressure: "A visible client must not request a server runtime that is unavailable or incompatible.",
    choice: "Publish the exact CLI first; stage and preflight the exact server runtime before launcher activation.",
    benefit: "An update target is reproducible and the managed-server trial has a defined rollback boundary.",
    cost: "Release order, launcher compatibility, and platform-specific update state machines remain necessary.",
    alternative: "Floating channel updates paired with a stronger compatibility negotiation protocol.",
    trigger: "Compatibility proof becomes sufficient without requiring equal client and server versions.",
  },
  {
    category: "connectivity",
    classification: "Shipped",
    title: "Scope-driven background work",
    pressure: "Mobile should remain useful in the background without keeping every environment permanently active.",
    choice: "Reference-counted scopes retain declared per-environment background demand.",
    benefit: "Continuation has an owner and can end when that owner releases its interest.",
    cost: "Scope cleanup and platform scheduling constraints remain part of correctness; it is not a durable job queue.",
    alternative: "An always-on global worker with higher resource use and leak risk.",
    trigger: "The product needs OS-managed durable jobs with explicit completion receipts.",
  },
];

const payload = JSON.stringify(decisions).replaceAll("<", "\\u003c");
const first = decisions[0];
---

<section class="decision-ledger" data-decision-ledger data-decision-ready="pending" aria-labelledby={`${id}-title`}>
  <header class="decision-ledger__head">
    <span>Interactive decision ledger</span>
    <h3 id={`${id}-title`}>Trace the trade-off, then test its reversal trigger</h3>
    <p>Filter the ledger, select a decision, and move through its six-step path. No animation advances on its own.</p>
  </header>

  <div class="decision-ledger__interactive" data-decision-interactive>
    <div class="decision-ledger__filters" aria-label="Filter decisions by category">
      <span>Category</span>
      <div role="group" aria-label="Decision categories">
        <button type="button" data-decision-filter="all" aria-pressed="true">All <small>{decisions.length}</small></button>
        <button type="button" data-decision-filter="domain" aria-pressed="false">Domain <small>2</small></button>
        <button type="button" data-decision-filter="delivery" aria-pressed="false">Delivery <small>2</small></button>
        <button type="button" data-decision-filter="integration" aria-pressed="false">Integration <small>1</small></button>
        <button type="button" data-decision-filter="connectivity" aria-pressed="false">Continuity <small>3</small></button>
        <button type="button" data-decision-filter="operations" aria-pressed="false">Operations <small>1</small></button>
      </div>
    </div>

    <div class="decision-ledger__body">
      <nav class="decision-ledger__list" aria-label="Architecture decisions" data-decision-list>
        {decisions.map((decision, index) => (
          <button
            type="button"
            data-decision-select={index}
            data-category={decision.category}
            aria-pressed={index === 0 ? "true" : "false"}
            class:list={{ "is-selected": index === 0 }}
          >
            <span>{decision.classification}</span>
            <strong>{decision.title}</strong>
          </button>
        ))}
      </nav>

      <article class="decision-ledger__detail" data-decision-detail tabindex="-1" aria-labelledby={`${id}-decision-title`}>
        <div class="decision-ledger__detail-head">
          <p><span data-decision-classification>{first.classification}</span> <span aria-hidden="true">·</span> <span data-decision-category>{first.category}</span></p>
          <h4 id={`${id}-decision-title`} data-decision-title>{first.title}</h4>
        </div>
        <ol class="decision-ledger__path" data-decision-path>
          <li class="is-active" data-decision-step="0"><span>1</span><strong>Pressure</strong><p data-decision-value>{first.pressure}</p></li>
          <li data-decision-step="1"><span>2</span><strong>Choice</strong><p data-decision-value>{first.choice}</p></li>
          <li data-decision-step="2"><span>3</span><strong>Benefit</strong><p data-decision-value>{first.benefit}</p></li>
          <li data-decision-step="3"><span>4</span><strong>Cost</strong><p data-decision-value>{first.cost}</p></li>
          <li data-decision-step="4"><span>5</span><strong>Alternative</strong><p data-decision-value>{first.alternative}</p></li>
          <li data-decision-step="5"><span>6</span><strong>Reversal trigger</strong><p data-decision-value>{first.trigger}</p></li>
        </ol>
        <div class="decision-ledger__controls">
          <button type="button" data-decision-prev aria-label="Show previous trade-off step">Previous</button>
          <p><strong data-decision-step-label>1</strong> of 6 · <span data-decision-step-name>Pressure</span></p>
          <button type="button" data-decision-next aria-label="Show next trade-off step">Next</button>
        </div>
      </article>
    </div>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-decision-status>
      Server authority selected. Step 1 of 6: Pressure.
    </p>
  </div>

  <details class="decision-ledger__static" open>
    <summary>Complete static ledger</summary>
    <div class="decision-ledger__table-wrap" tabindex="0" role="region" aria-label="Complete architecture decision ledger">
      <table>
        <thead><tr><th>Decision</th><th>Pressure</th><th>Choice</th><th>Benefit</th><th>Cost</th><th>Alternative</th><th>Reversal trigger</th></tr></thead>
        <tbody>
          {decisions.map((decision) => (
            <tr>
              <th scope="row"><span>{decision.classification}</span>{decision.title}</th>
              <td>{decision.pressure}</td>
              <td>{decision.choice}</td>
              <td>{decision.benefit}</td>
              <td>{decision.cost}</td>
              <td>{decision.alternative}</td>
              <td>{decision.trigger}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <noscript><p class="decision-ledger__noscript">The complete static ledger remains available above without JavaScript.</p></noscript>
  <script type="application/json" data-decision-data set:html={payload}></script>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-decision-ledger]").forEach((lab) => {
    if (lab.dataset.decisionReady === "true") return;
    try {
    const decisions = JSON.parse(lab.querySelector("[data-decision-data]")?.textContent ?? "[]");
    const selectorButtons = [...lab.querySelectorAll<HTMLButtonElement>("[data-decision-select]")];
    const filterButtons = [...lab.querySelectorAll<HTMLButtonElement>("[data-decision-filter]")];
    const pathItems = [...lab.querySelectorAll<HTMLElement>("[data-decision-step]")];
    const labels = ["Pressure", "Choice", "Benefit", "Cost", "Alternative", "Reversal trigger"];
    const fields = ["pressure", "choice", "benefit", "cost", "alternative", "trigger"];
    let visible = decisions.map((_: unknown, index: number) => index);
    let selected = 0;
    let step = 0;

    const text = (selector: string, value: string) => {
      const element = lab.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };
    const render = (focusDetail = false) => {
      const decision = decisions[selected];
      if (!decision) return;
      selectorButtons.forEach((button, index) => {
        const active = index === selected;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("is-selected", active);
      });
      text("[data-decision-classification]", decision.classification);
      text("[data-decision-category]", decision.category);
      text("[data-decision-title]", decision.title);
      pathItems.forEach((item, index) => {
        item.classList.toggle("is-active", index === step);
        const value = item.querySelector<HTMLElement>("[data-decision-value]");
        if (value) value.textContent = decision[fields[index]];
      });
      text("[data-decision-step-label]", String(step + 1));
      text("[data-decision-step-name]", labels[step]);
      text("[data-decision-status]", `${decision.title} selected. Step ${step + 1} of 6: ${labels[step]}. ${decision[fields[step]]}`);
      const previous = lab.querySelector<HTMLButtonElement>("[data-decision-prev]");
      const next = lab.querySelector<HTMLButtonElement>("[data-decision-next]");
      if (previous) previous.disabled = step === 0;
      if (next) next.disabled = step === fields.length - 1;
      const detail = lab.querySelector<HTMLElement>("[data-decision-detail]");
      if (detail) {
        detail.classList.remove("is-moving");
        void detail.offsetWidth;
        detail.classList.add("is-moving");
        if (focusDetail) detail.focus();
      }
    };
    const applyFilter = (filter: string, focus = false) => {
      visible = decisions.map((decision: { category: string }, index: number) => decision.category === filter || filter === "all" ? index : -1).filter((index: number) => index >= 0);
      selectorButtons.forEach((button, index) => {
        const isVisible = visible.includes(index);
        button.hidden = !isVisible;
        button.tabIndex = isVisible ? 0 : -1;
      });
      filterButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.decisionFilter === filter)));
      if (!visible.includes(selected)) selected = visible[0] ?? 0;
      step = 0;
      render(focus);
    };

    selectorButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selected = Number(button.dataset.decisionSelect);
        step = 0;
        render(true);
      });
      button.addEventListener("keydown", (event) => {
        const current = visible.indexOf(Number(button.dataset.decisionSelect));
        let target: number | undefined;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") target = visible[(current + 1) % visible.length];
        if (event.key === "ArrowUp" || event.key === "ArrowLeft") target = visible[(current - 1 + visible.length) % visible.length];
        if (event.key === "Home") target = visible[0];
        if (event.key === "End") target = visible[visible.length - 1];
        if (target === undefined) return;
        event.preventDefault();
        selected = target;
        step = 0;
        render();
        selectorButtons[selected]?.focus();
      });
    });
    filterButtons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.decisionFilter ?? "all")));
    lab.querySelector("[data-decision-prev]")?.addEventListener("click", () => { if (step > 0) { step -= 1; render(); } });
    lab.querySelector("[data-decision-next]")?.addEventListener("click", () => { if (step < fields.length - 1) { step += 1; render(); } });
    render();
    lab.dataset.decisionReady = "true";
    } catch (error) {
      console.error("Decision ledger could not initialize", error);
      lab.dataset.decisionReady = "failed";
    }
  });
</script>

<style>
  .decision-ledger { margin: 2.5rem 0; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 1rem; background: var(--paper-raised); box-shadow: var(--shadow); font-family: var(--font-ui); }
  .decision-ledger__head { padding: 1.25rem; border-bottom: 1px solid var(--line); background: linear-gradient(125deg, color-mix(in srgb, var(--signal) 10%, var(--paper)), var(--paper)); }
  .decision-ledger__head > span { color: var(--signal-deep); font: 800 .63rem/1 var(--font-ui); letter-spacing: .13em; text-transform: uppercase; }
  .decision-ledger h3 { margin: .45rem 0 .25rem; font: 800 clamp(1.15rem, 2vw, 1.45rem)/1.15 var(--font-display); letter-spacing: -.025em; }
  .decision-ledger__head p { max-width: 45rem; margin: 0; color: var(--ink-soft); font: .8rem/1.5 var(--font-ui); }
  .decision-ledger:is([data-decision-ready="pending"], [data-decision-ready="failed"]) .decision-ledger__interactive { display: none; }
  .decision-ledger[data-decision-ready="true"] .decision-ledger__static, .decision-ledger[data-decision-ready="true"] .decision-ledger__noscript { display: none; }
  .decision-ledger__filters { padding: .85rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--paper-muted); }
  .decision-ledger__filters > span { display: block; margin-bottom: .45rem; color: var(--ink-faint); font: 800 .62rem/1 var(--font-ui); letter-spacing: .1em; text-transform: uppercase; }
  .decision-ledger__filters > div { display: flex; flex-wrap: wrap; gap: .4rem; }
  .decision-ledger button { min-height: 2.35rem; border: 1px solid var(--line-strong); border-radius: .45rem; background: var(--paper); color: var(--ink); font: 750 .71rem/1.2 var(--font-ui); cursor: pointer; }
  .decision-ledger button:focus-visible, .decision-ledger__detail:focus-visible, .decision-ledger__table-wrap:focus-visible { outline: 3px solid var(--signal); outline-offset: 2px; }
  .decision-ledger__filters button { padding: .42rem .58rem; }
  .decision-ledger__filters button[aria-pressed="true"] { border-color: var(--signal); background: color-mix(in srgb, var(--signal) 13%, var(--paper)); color: var(--signal-deep); }
  .decision-ledger button small { margin-left: .18rem; opacity: .7; font: inherit; }
  .decision-ledger__body { display: grid; grid-template-columns: minmax(11rem, .72fr) minmax(0, 1.6fr); align-items: stretch; }
  .decision-ledger__list { display: grid; align-content: start; gap: .35rem; padding: .75rem; border-right: 1px solid var(--line); background: var(--paper-muted); }
  .decision-ledger__list button { display: grid; gap: .22rem; min-width: 0; padding: .65rem .7rem; text-align: left; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  .decision-ledger__list button[hidden] { display: none; }
  .decision-ledger__list button > span, .decision-ledger__detail-head p { color: var(--ink-faint); font: 800 .58rem/1.2 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; }
  .decision-ledger__list button > strong { font: 760 .77rem/1.22 var(--font-ui); }
  .decision-ledger__list button.is-selected { border-color: var(--signal); background: color-mix(in srgb, var(--signal) 12%, var(--paper)); transform: translateX(.18rem); }
  .decision-ledger__detail { min-width: 0; padding: 1rem 1.1rem 1.15rem; background: var(--paper); }
  .decision-ledger__detail.is-moving { animation: decision-ledger-enter .28s ease-out both; }
  .decision-ledger__detail-head { padding-bottom: .75rem; border-bottom: 1px solid var(--line); }
  .decision-ledger__detail-head p { margin: 0 0 .28rem; }
  .decision-ledger h4 { margin: 0; font: 800 1.1rem/1.2 var(--font-display); letter-spacing: -.015em; }
  .decision-ledger__path { display: grid; gap: .45rem; margin: 1rem 0; padding: 0; list-style: none; }
  .decision-ledger__path li { display: grid; grid-template-columns: 1.5rem minmax(6.2rem, .28fr) minmax(0, 1fr); gap: .55rem; align-items: start; padding: .55rem; border-left: 3px solid var(--line); background: var(--paper-muted); opacity: .58; transition: opacity .2s ease, transform .2s ease, border-color .2s ease, background .2s ease; }
  .decision-ledger__path li > span { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: var(--paper); color: var(--ink-soft); font: 800 .62rem/1 var(--font-ui); }
  .decision-ledger__path strong { padding-top: .14rem; font: 800 .67rem/1.25 var(--font-ui); letter-spacing: .04em; text-transform: uppercase; }
  .decision-ledger__path p { margin: 0; color: var(--ink-soft); font: .73rem/1.44 var(--font-ui); }
  .decision-ledger__path li.is-active { border-left-color: var(--signal); background: color-mix(in srgb, var(--signal) 10%, var(--paper)); opacity: 1; transform: translateX(.22rem); }
  .decision-ledger__path li.is-active > span { background: var(--signal); color: var(--paper); }
  .decision-ledger__controls { display: grid; grid-template-columns: auto 1fr auto; gap: .6rem; align-items: center; padding-top: .8rem; border-top: 1px solid var(--line); }
  .decision-ledger__controls button { padding: .48rem .65rem; }
  .decision-ledger__controls button:disabled { opacity: .45; cursor: not-allowed; }
  .decision-ledger__controls p { margin: 0; color: var(--ink-soft); text-align: center; font: .7rem/1.3 var(--font-ui); }
  .decision-ledger__static { margin: 0; padding: 1rem 1.25rem 1.25rem; border-top: 1px solid var(--line); }
  .decision-ledger__static summary { cursor: pointer; color: var(--ink-soft); font: 750 .78rem/1.35 var(--font-ui); }
  .decision-ledger__table-wrap { overflow: auto; margin-top: .7rem; border: 1px solid var(--line); border-radius: .55rem; }
  .decision-ledger table { width: 100%; min-width: 72rem; border-collapse: collapse; font: .7rem/1.43 var(--font-ui); }
  .decision-ledger th, .decision-ledger td { padding: .65rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .decision-ledger thead { background: var(--paper-muted); }
  .decision-ledger tbody tr:last-child > * { border-bottom: 0; }
  .decision-ledger tbody th { width: 15%; font-weight: 800; }
  .decision-ledger tbody th span { display: block; margin-bottom: .22rem; color: var(--signal-deep); font: 800 .55rem/1 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; }
  .decision-ledger__noscript { margin: 0 1.25rem 1rem; color: var(--ink-soft); font: .75rem/1.4 var(--font-ui); }
  @keyframes decision-ledger-enter { from { opacity: .55; transform: translateX(.3rem); } to { opacity: 1; transform: translateX(0); } }
  @media (max-width: 52rem) { .decision-ledger__head, .decision-ledger__filters, .decision-ledger__static { padding-left: 1rem; padding-right: 1rem; } .decision-ledger__body { grid-template-columns: 1fr; } .decision-ledger__list { grid-template-columns: repeat(auto-fit, minmax(8.8rem, 1fr)); border-right: 0; border-bottom: 1px solid var(--line); } .decision-ledger__list button.is-selected { transform: translateY(-.12rem); } .decision-ledger__path li { grid-template-columns: 1.4rem 1fr; } .decision-ledger__path p { grid-column: 2; } }
  @media (max-width: 28rem) { .decision-ledger__controls { grid-template-columns: 1fr 1fr; } .decision-ledger__controls p { grid-column: 1 / -1; grid-row: 1; } }
  @media (prefers-reduced-motion: reduce) { .decision-ledger *, .decision-ledger *::before, .decision-ledger *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } .decision-ledger__list button.is-selected, .decision-ledger__path li.is-active { transform: none; } }
  @media print { .decision-ledger { break-inside: avoid; box-shadow: none; border-color: #777; } .decision-ledger__interactive, .decision-ledger__noscript { display: none !important; } .decision-ledger__static { display: block; border-top: 0; } .decision-ledger__table-wrap { overflow: visible; } .decision-ledger table { min-width: 0; font-size: 7.5pt; } }
</style>
